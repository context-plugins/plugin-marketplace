{
  "name": "cribl-api-reference",
  "version": "4.20.3-ea354447",
  "description": "This API Reference lists available REST endpoints, along with their supported operations for accessing, creating, updating, or deleting resources.\nBase URL contexts for reference:\n- Leader context: /api/v1\n- Worker Group or Edge Fleet context: /api/v1/m/{groupName}\n- Host (Worker or Edge Node) context: /api/v1/w/{nodeId}\n- Search context: /api/v1/m/default_search",
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/commonjs/index.d.ts",
        "default": "./dist/commonjs/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "tshy": {
    "exports": {
      ".": "./src/index.ts",
      "./package.json": "./package.json"
    },
    "dialects": [
      "esm",
      "commonjs"
    ],
    "project": "./tsconfig.tshy.json",
    "selfLink": false
  },
  "main": "./dist/commonjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/commonjs/index.d.ts",
  "files": [
    "dist",
    "src",
    "tsconfig.json",
    "tsconfig.tshy.json",
    "README.md",
    "api-reference.md",
    "sdk-map.md",
    "map"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20.3"
  },
  "scripts": {
    "prepare": "tshy",
    "build": "tshy",
    "smoke": "node -e \"require('cribl-api-reference')\" && node --input-type=module -e \"import('cribl-api-reference')\"",
    "typecheck": "tsc --noEmit",
    "typecheck:dom": "tsc --noEmit -p tsconfig.dom.json",
    "lint": "oxlint --type-aware --max-warnings=0 src",
    "format": "oxfmt src",
    "format:check": "oxfmt --check src"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.14.0",
    "oxfmt": "^0.61.0",
    "oxlint": "^1.76.0",
    "oxlint-tsgolint": "^7.0.2001",
    "tshy": "^4.1.3",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "zod": "^4.1.0"
  }
}
